# Salin file ini menjadi ".env.local" lalu isi nilainya (lihat README.md, langkah 4).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# "anon" / "publishable" key (aman dilihat publik)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" / "secret" key — RAHASIA, jangan dibagikan atau di-commit
SUPABASE_SERVICE_ROLE_KEY=

# Alamat website (dipakai untuk membuat tautan pribadi anggota)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opsional: Cloudflare Turnstile (captcha gratis) untuk formulir publik
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
